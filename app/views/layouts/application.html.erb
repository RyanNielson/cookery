<!DOCTYPE html>
<html lang="en" class="h-full" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "Cookery" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cookery">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <script>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme = stored || "system";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const shouldUseDark = theme === "dark" || (theme === "system" && prefersDark);
        document.documentElement.classList.toggle("dark", shouldUseDark);
      })();
    </script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  </head>

  <body class="min-h-full bg-[#fff8f1] text-slate-900 dark:bg-[#0f141c] dark:text-slate-100">
    <div class="relative">
      <header class="border-b border-[#f1dfd4] bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/60">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5">
          <div class="flex items-center gap-4">
            <%= link_to recipes_path, class: "flex flex-col leading-tight" do %>
              <span class="text-2xl font-semibold tracking-tight">Cookery</span>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <% nav_link_class = ->(path) do
              base_classes = "px-4 py-2 text-sm font-semibold text-slate-700 transition hover:text-[#ff613c] dark:text-slate-100 first:rounded-l-full last:rounded-r-full"
              active_classes = "bg-[#ff7a59]/15 text-[#ff613c] dark:bg-[#ff7a59]/20"
              [base_classes, (active_classes if current_page?(path))].compact.join(" ")
            end %>
            <div class="flex overflow-hidden rounded-full border border-slate-200/80 bg-white/80 shadow-sm dark:border-slate-700/80 dark:bg-slate-900/80">
              <%= link_to "Recipes", recipes_path, class: nav_link_class.call(recipes_path) %>
              <span class="h-full w-px bg-slate-200/80 dark:bg-slate-700/80"></span>
              <%= link_to "Meal plans", meal_plan_path, class: nav_link_class.call(meal_plan_path) %>
              <span class="h-full w-px bg-slate-200/80 dark:bg-slate-700/80"></span>
              <%= link_to "Grocery lists", grocery_lists_path, class: nav_link_class.call(grocery_lists_path) %>
            </div>
            <details class="relative">
              <summary class="cursor-pointer list-none rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:bg-white dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100 dark:hover:bg-slate-900 [&::-webkit-details-marker]:hidden">
                Theme
              </summary>
              <div class="absolute right-0 z-10 mt-2 w-40 overflow-hidden rounded-2xl border border-slate-200/80 bg-white/95 shadow-lg backdrop-blur dark:border-slate-700/80 dark:bg-slate-900/95">
                <% theme_button_class = "flex w-full cursor-pointer items-center justify-between px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-[#ff7a59]/10 hover:text-[#ff613c] aria-pressed:bg-[#ff7a59]/15 aria-pressed:text-[#ff613c] dark:text-slate-100 dark:hover:bg-[#ff7a59]/20 dark:aria-pressed:bg-[#ff7a59]/25" %>
                <button type="button" class="<%= theme_button_class %>" data-theme-value="system" data-theme-target="option" data-action="theme#set">System</button>
                <button type="button" class="<%= theme_button_class %>" data-theme-value="light" data-theme-target="option" data-action="theme#set">Light</button>
                <button type="button" class="<%= theme_button_class %>" data-theme-value="dark" data-theme-target="option" data-action="theme#set">Dark</button>
              </div>
            </details>
          </div>
        </div>
      </header>

      <main class="mx-auto flex w-full max-w-6xl flex-col px-6 pb-16 pt-10">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
