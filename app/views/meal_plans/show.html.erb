<% content_for :title, "Meal plan" %>

<div class="w-full space-y-8">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-black bg-neutral-900 px-4 py-2 text-sm font-semibold text-white" id="alert">
      <span class="inline-flex h-2 w-2 rounded-none bg-white"></span>
      <%= alert %>
    </p>
  <% end %>

  <% if @meal_plan_entry&.errors&.any? %>
    <div class="rounded-none border-2 border-black bg-neutral-50 p-5 text-sm text-neutral-900">
      <p class="font-semibold"><%= pluralize(@meal_plan_entry.errors.count, "error") %> stopped this meal from saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @meal_plan_entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-4xl font-semibold leading-tight text-black sm:text-5xl">Meal plan</h1>
      <p class="mt-2 text-sm text-neutral-500">
        Week of <%= @starts_on.strftime("%B %-d") %> – <%= (@starts_on + 6.days).strftime("%B %-d") %>
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "This week", meal_plan_path, class: "rounded-none border-2 border-neutral-300 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <%= link_to "Prev week", meal_plan_path(week: @starts_on - 7.days), class: "rounded-none border-2 border-neutral-300 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <%= link_to "Next week", meal_plan_path(week: @starts_on + 7.days), class: "rounded-none border-2 border-neutral-300 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <% grocery_list_params = @meal_plan ? { meal_plan_ids: [ @meal_plan.id ] } : {} %>
      <%= link_to "Build grocery list", new_grocery_list_path(grocery_list_params), class: "rounded-none border-2 border-black bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-4 animate-stagger">
    <% @week_days.each do |day| %>
      <div class="rounded-none border-2 border-neutral-200 bg-white p-5">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-lg font-semibold text-black"><%= day.strftime("%A") %></h2>
          <span class="text-xs font-semibold uppercase tracking-wide text-neutral-400"><%= day.strftime("%b %-d") %></span>
        </div>

        <div class="mt-4 space-y-3">
          <% day_entries = @entries_by_day[day] || [] %>
          <% if day_entries.any? %>
            <% day_entries.each do |entry| %>
              <div class="flex items-center justify-between gap-3 rounded-none border-2 border-neutral-200 bg-neutral-50 px-3 py-2 text-sm text-neutral-700">
                <%= link_to entry.recipe.name, recipe_path(entry.recipe), class: "font-semibold text-black hover:text-neutral-600" %>
                <%= button_to "Remove", meal_plan_entry_path(entry, week: @starts_on), method: :delete, class: "rounded-none border-2 border-neutral-300 bg-white px-3 py-1 text-xs font-semibold text-neutral-600 transition hover:border-black hover:text-black hover:cursor-pointer", data: { turbo_confirm: "Remove this meal?" } %>
              </div>
            <% end %>
          <% else %>
            <p class="rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-3 text-sm text-neutral-500">Nothing planned yet.</p>
          <% end %>
        </div>

        <div class="mt-4">
          <% if @recipes.any? %>
            <%= form_with url: meal_plan_entries_path, method: :post, class: "flex flex-col gap-2" do |form| %>
              <% if @meal_plan.present? %>
                <%= hidden_field_tag :meal_plan_id, @meal_plan.id %>
              <% end %>
              <%= hidden_field_tag "meal_plan_entry[planned_on]", day %>
              <%= select_tag "meal_plan_entry[recipe_id]", options_from_collection_for_select(@recipes, :id, :name), include_blank: "Add a recipe...", class: "w-full rounded-none border-2 border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-700 focus:border-black focus:outline-none focus:ring-2 focus:ring-black/10" %>
              <%= form.submit "Add to day", class: "rounded-none bg-black px-4 py-2 text-xs font-semibold text-white transition hover:bg-neutral-800 hover:cursor-pointer" %>
            <% end %>
          <% else %>
            <p class="text-sm text-neutral-500">Add recipes to start planning.</p>
            <%= link_to "Create a recipe", new_recipe_path, class: "mt-2 inline-flex rounded-none border-2 border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
