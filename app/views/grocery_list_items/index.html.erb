<% content_for :title, "Grocery list items" %>

<div class="w-full space-y-6">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-semibold text-black">Grocery list items</h1>
    <%= link_to "New grocery list item", new_grocery_list_item_path, class: "rounded-none bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
  </div>

  <div id="grocery_list_items" class="min-w-full divide-y divide-neutral-200 space-y-4">
    <% if @grocery_list_items.any? %>
      <% @grocery_list_items.each do |grocery_list_item| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render grocery_list_item %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", grocery_list_item, class: "w-full sm:w-auto text-center rounded-none border-2 border-neutral-300 px-3.5 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
            <%= link_to "Edit", edit_grocery_list_item_path(grocery_list_item), class: "w-full sm:w-auto text-center rounded-none border-2 border-neutral-300 px-3.5 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
            <%= button_to "Destroy", grocery_list_item, method: :delete, class: "w-full sm:w-auto rounded-none bg-black px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="my-10 text-center text-sm text-neutral-500">No grocery list items found.</p>
    <% end %>
  </div>
</div>
