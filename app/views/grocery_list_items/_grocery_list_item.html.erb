<div class="flex items-center justify-between gap-3 rounded-none border-2 border-neutral-200 bg-neutral-50 px-4 py-3">
  <p class="text-base font-semibold <%= item.purchased? ? "text-neutral-400 line-through" : "text-black" %>">
    <span><%= item.name %></span>
    <% if item.quantity_text.present? %>
      <span class="text-sm font-normal text-neutral-500"> · <%= item.quantity_text %></span>
    <% end %>
  </p>
  <%= button_to grocery_list_grocery_list_item_path(grocery_list, item), method: :patch, params: { grocery_list_item: { purchased: !item.purchased } }, class: "inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-none border-2 text-xs font-semibold transition #{item.purchased? ? "border-black bg-black text-white" : "border-neutral-400 bg-white text-neutral-700 hover:border-black hover:text-black"}", aria: { pressed: item.purchased? } do %>
    <span class="<%= item.purchased? ? "opacity-100" : "opacity-0" %>">✓</span>
  <% end %>
</div>
