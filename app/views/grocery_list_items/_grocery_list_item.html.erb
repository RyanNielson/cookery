<div class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white/70 px-4 py-3 dark:border-slate-700/80 dark:bg-slate-950/40">
  <p class="text-base font-semibold <%= item.purchased? ? "text-slate-400 line-through" : "text-slate-900 dark:text-white" %>">
    <span><%= item.name %></span>
    <% if item.quantity_text.present? %>
      <span class="text-sm font-normal text-slate-500 dark:text-slate-400"> · <%= item.quantity_text %></span>
    <% end %>
  </p>
  <%= button_to grocery_list_grocery_list_item_path(grocery_list, item), method: :patch, params: { grocery_list_item: { purchased: !item.purchased } }, class: "inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-slate-400 bg-white text-xs font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:border-[#ff7a59] hover:text-[#ff613c] dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:ring-slate-700 #{item.purchased? ? "bg-emerald-50 text-emerald-600 border-emerald-300 dark:bg-emerald-500/10 dark:text-emerald-200 dark:border-emerald-400/60" : ""}", aria: { pressed: item.purchased? } do %>
    <span class="<%= item.purchased? ? "opacity-100" : "opacity-0" %>">✓</span>
  <% end %>
</div>
