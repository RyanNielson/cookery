<% content_for :title, "Editing grocery list item" %>

<div class="w-full space-y-6">
  <h1 class="text-3xl font-semibold text-black">Editing grocery list item</h1>

  <%= render "form", grocery_list_item: @grocery_list_item %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Show this grocery list item", @grocery_list_item, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
    <%= link_to "Back to grocery list items", grocery_list_items_path, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
  </div>
</div>
