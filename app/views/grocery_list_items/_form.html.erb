<%= form_with(model: grocery_list_item, class: "contents") do |form| %>
  <% if grocery_list_item.errors.any? %>
    <div id="error_explanation" class="mt-3 rounded-none border-2 border-black bg-neutral-50 px-3 py-2 font-medium text-neutral-900">
      <h2><%= pluralize(grocery_list_item.errors.count, "error") %> prohibited this grocery_list_item from being saved:</h2>

      <ul class="ml-6 list-disc text-neutral-700">
        <% grocery_list_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :grocery_list_id %>
    <%= form.text_field :grocery_list_id, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list_item.errors[:grocery_list_id].none?, "border-black": grocery_list_item.errors[:grocery_list_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list_item.errors[:name].none?, "border-black": grocery_list_item.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :quantity_text %>
    <%= form.text_field :quantity_text, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list_item.errors[:quantity_text].none?, "border-black": grocery_list_item.errors[:quantity_text].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :purchased %>
    <%= form.checkbox :purchased, class: ["order-first h-5 w-5 cursor-pointer rounded-none border-2 focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list_item.errors[:purchased].none?, "border-black": grocery_list_item.errors[:purchased].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "inline-block w-full rounded-none bg-black px-3.5 py-2.5 font-medium text-white hover:bg-neutral-800 sm:w-auto cursor-pointer" %>
  </div>
<% end %>
