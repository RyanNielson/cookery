<%= form_with(model: grocery_list_item, class: "contents") do |form| %>
  <% if grocery_list_item.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(grocery_list_item.errors.count, "error") %> prohibited this grocery_list_item from being saved:</h2>

      <ul class="list-disc ml-6">
        <% grocery_list_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :grocery_list_id %>
    <%= form.text_field :grocery_list_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grocery_list_item.errors[:grocery_list_id].none?, "border-red-400 focus:outline-red-600": grocery_list_item.errors[:grocery_list_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grocery_list_item.errors[:name].none?, "border-red-400 focus:outline-red-600": grocery_list_item.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :quantity_text %>
    <%= form.text_field :quantity_text, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grocery_list_item.errors[:quantity_text].none?, "border-red-400 focus:outline-red-600": grocery_list_item.errors[:quantity_text].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :purchased %>
    <%= form.checkbox :purchased, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": grocery_list_item.errors[:purchased].none?, "border-red-400 focus:outline-red-600": grocery_list_item.errors[:purchased].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
