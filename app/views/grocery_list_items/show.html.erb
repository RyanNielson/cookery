<% content_for :title, "Showing grocery list item" %>

<div class="w-full space-y-6">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <h1 class="text-3xl font-semibold text-black">Showing grocery list item</h1>

  <%= render @grocery_list_item %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Edit this grocery list item", edit_grocery_list_item_path(@grocery_list_item), class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
    <%= link_to "Back to grocery list items", grocery_list_items_path, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
    <%= button_to "Destroy this grocery list item", @grocery_list_item, method: :delete, class: "rounded-none bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
