<article id="<%= dom_id recipe %>" class="group relative overflow-hidden rounded-none border-2 border-neutral-200 bg-white p-4 transition hover:-translate-y-1">
  <div class="space-y-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold leading-tight text-black">
          <%= link_to recipe.name, recipe, class: "transition hover:text-neutral-600" %>
        </h2>
        <p class="mt-2 text-sm text-neutral-600">
          <%= truncate(recipe.description.to_s, length: 140, separator: " ") %>
        </p>
      </div>
      <div class="flex flex-col items-end gap-2 text-xs font-semibold uppercase tracking-wide text-neutral-500">
        <span class="rounded-none border-2 border-neutral-300 bg-white px-3 py-1">
          <%= pluralize(recipe.ingredients.size, "ingredient") %>
        </span>
        <span class="rounded-none border-2 border-neutral-300 bg-white px-3 py-1">
          <%= pluralize(recipe.instructions.size, "step") %>
        </span>
      </div>
    </div>

    <% if recipe.image.attached? && recipe.image.variable? %>
      <div class="overflow-hidden rounded-none border-2 border-neutral-200 bg-neutral-100">
        <%= image_tag recipe.image.variant(resize_to_limit: [800, 800], format: :jpg), class: "h-40 w-full object-cover transition group-hover:scale-105" %>
      </div>
    <% end %>

    <% if recipe.ingredients.any? %>
      <div class="flex flex-wrap gap-2 text-xs">
        <% recipe.ingredients.first(4).each do |ingredient| %>
          <span class="rounded-none bg-neutral-100 px-3 py-1 text-neutral-700">
            <%= ingredient.name %>
          </span>
        <% end %>
        <% if recipe.ingredients.size > 4 %>
          <span class="rounded-none bg-neutral-100 px-3 py-1 text-neutral-700">
            +<%= recipe.ingredients.size - 4 %> more
          </span>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Show", recipe, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <%= link_to "Edit", edit_recipe_path(recipe), class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <%= button_to "Delete", recipe, method: :delete, class: "rounded-none bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</article>
