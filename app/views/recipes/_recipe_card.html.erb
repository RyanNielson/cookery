<article id="<%= dom_id recipe %>" class="group relative overflow-hidden rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-sm shadow-orange-100/60 backdrop-blur transition hover:-translate-y-1 dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none">
  <div class="space-y-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold leading-tight text-slate-900 dark:text-white">
          <%= link_to recipe.name, recipe, class: "transition hover:text-[#ff613c]" %>
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          <%= truncate(recipe.description.to_s, length: 140, separator: " ") %>
        </p>
      </div>
      <div class="flex flex-col items-end gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
        <span class="rounded-full border border-slate-200/80 bg-white/70 px-3 py-1 dark:border-slate-700/80 dark:bg-slate-900/70">
          <%= pluralize(recipe.ingredients.size, "ingredient") %>
        </span>
        <span class="rounded-full border border-slate-200/80 bg-white/70 px-3 py-1 dark:border-slate-700/80 dark:bg-slate-900/70">
          <%= pluralize(recipe.instructions.size, "step") %>
        </span>
      </div>
    </div>

    <% if recipe.image.attached? && recipe.image.variable? %>
      <div class="overflow-hidden rounded-2xl border border-slate-200/60 bg-slate-100 dark:border-slate-800/60 dark:bg-slate-900">
        <%= image_tag recipe.image.variant(resize_to_limit: [800, 800], format: :jpg), class: "h-48 w-full object-cover transition group-hover:scale-105" %>
      </div>
    <% end %>

    <% if recipe.ingredients.any? %>
      <div class="flex flex-wrap gap-2 text-xs">
        <% recipe.ingredients.first(4).each do |ingredient| %>
          <span class="rounded-full bg-[#fff0e4] px-3 py-1 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <%= ingredient.name %>
          </span>
        <% end %>
        <% if recipe.ingredients.size > 4 %>
          <span class="rounded-full bg-[#fff0e4] px-3 py-1 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
            +<%= recipe.ingredients.size - 4 %> more
          </span>
        <% end %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Show", recipe, class: "rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#ff7a59] hover:text-[#ff613c] dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100" %>
      <%= link_to "Edit", edit_recipe_path(recipe), class: "rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#ff7a59] hover:text-[#ff613c] dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100" %>
      <%= button_to "Delete", recipe, method: :delete, class: "rounded-full bg-[#ff7a59] px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-orange-200 transition hover:bg-[#ff613c] cursor-pointer dark:shadow-none", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</article>
