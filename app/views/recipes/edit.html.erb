<% content_for :title, "Editing recipe" %>

<div class="w-full space-y-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-500">Edit</p>
    <h1 class="mt-3 text-4xl font-semibold text-black sm:text-5xl">Tweak your recipe</h1>
    <p class="mt-2 text-base text-neutral-600">
      Fine-tune the ingredients and steps until it reads just right.
    </p>
  </div>

  <%= render "form", recipe: @recipe %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Show recipe", @recipe, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
  </div>
</div>
