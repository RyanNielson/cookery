<% content_for :title, "New recipe" %>

<div class="w-full space-y-8">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-500">New</p>
    <h1 class="mt-3 text-4xl font-semibold text-black sm:text-5xl">Create a recipe</h1>
  </div>

  <%= render "form", recipe: @recipe %>

  <%= link_to "Back to recipes", recipes_path, class: "inline-flex rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
</div>
