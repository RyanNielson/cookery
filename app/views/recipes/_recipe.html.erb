<div id="<%= dom_id recipe %>" class="space-y-8">
  <section class="overflow-hidden rounded-none border-2 border-neutral-200 bg-white">
    <div class="grid gap-8 p-4 md:grid-cols-[1.1fr,0.9fr] md:p-8">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-500">Recipe</p>
        <h1 class="text-4xl font-semibold leading-tight text-black sm:text-5xl"><%= recipe.name %></h1>
        <p class="text-base text-neutral-600 sm:text-lg"><%= recipe.description %></p>
        <div class="flex flex-wrap gap-3 text-sm font-semibold text-neutral-700">
          <span class="rounded-none border-2 border-neutral-300 bg-neutral-100 px-4 py-2">
            <%= pluralize(recipe.ingredients.size, "ingredient") %>
          </span>
          <span class="rounded-none border-2 border-neutral-300 bg-neutral-100 px-4 py-2">
            <%= pluralize(recipe.instructions.size, "step") %>
          </span>
        </div>
      </div>
      <div>
        <% if recipe.image.attached? %>
          <% if recipe.image.variable? %>
            <%= image_tag recipe.image.variant(resize_to_limit: [1200, 1200], format: :jpg), class: "h-full w-full rounded-none border-2 border-neutral-200 object-cover" %>
          <% else %>
            <%= link_to recipe.image.filename.to_s, url_for(recipe.image), class: "text-sm font-semibold text-neutral-700 underline" %>
          <% end %>
        <% else %>
          <div class="flex h-full min-h-[220px] items-center justify-center rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 text-sm font-semibold text-neutral-500">
            Add a photo when you're ready.
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-none border-2 border-neutral-200 bg-white p-4">
      <h2 class="text-2xl font-semibold text-black">Ingredients</h2>
      <% if recipe.ingredients.any? %>
        <ul class="mt-4 space-y-2 text-sm text-neutral-700">
          <% recipe.ingredients.each do |ingredient| %>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-none bg-black"></span>
              <span><%= [ingredient.quantity, ingredient.unit, ingredient.name].compact_blank.join(" ") %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-neutral-500">No ingredients yet.</p>
      <% end %>
    </div>

    <div class="rounded-none border-2 border-neutral-200 bg-white p-4">
      <h2 class="text-2xl font-semibold text-black">Instructions</h2>
      <% if recipe.instructions.any? %>
        <ol class="mt-4 space-y-3 text-sm text-neutral-700">
          <% recipe.instructions.each_with_index do |instruction, index| %>
            <li class="flex gap-3">
              <span class="flex h-7 w-7 items-center justify-center rounded-none bg-black text-xs font-semibold text-white">
                <%= index + 1 %>
              </span>
              <span class="flex-1"><%= instruction.body %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-4 text-sm text-neutral-500">No instructions yet.</p>
      <% end %>
    </div>
  </section>
</div>
