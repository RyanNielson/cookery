<div id="<%= dom_id recipe %>" class="space-y-8">
  <section class="overflow-hidden rounded-3xl border border-slate-200/70 bg-white/80 shadow-sm shadow-orange-100/60 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none">
    <div class="grid gap-8 p-6 md:grid-cols-[1.1fr,0.9fr] md:p-10">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Recipe</p>
        <h1 class="text-4xl font-semibold leading-tight text-slate-900 dark:text-white sm:text-5xl"><%= recipe.name %></h1>
        <p class="text-base text-slate-600 dark:text-slate-300 sm:text-lg"><%= recipe.description %></p>
        <div class="flex flex-wrap gap-3 text-sm font-semibold text-slate-700 dark:text-slate-200">
          <span class="rounded-full bg-[#fff0e4] px-4 py-2 dark:bg-slate-800">
            <%= pluralize(recipe.ingredients.size, "ingredient") %>
          </span>
          <span class="rounded-full bg-[#e6f7f1] px-4 py-2 dark:bg-slate-800">
            <%= pluralize(recipe.instructions.size, "step") %>
          </span>
        </div>
      </div>
      <div>
        <% if recipe.image.attached? %>
          <% if recipe.image.variable? %>
            <%= image_tag recipe.image.variant(resize_to_limit: [1200, 1200], format: :jpg), class: "h-full w-full rounded-2xl border border-slate-200/60 object-cover shadow-sm dark:border-slate-800/60" %>
          <% else %>
            <%= link_to recipe.image.filename.to_s, url_for(recipe.image), class: "text-sm font-semibold text-[#ff613c]" %>
          <% end %>
        <% else %>
          <div class="flex h-full min-h-[220px] items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-[#fff7f1] text-sm font-semibold text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
            Add a photo when you're ready.
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-sm shadow-orange-100/60 dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none">
      <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Ingredients</h2>
      <% if recipe.ingredients.any? %>
        <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          <% recipe.ingredients.each do |ingredient| %>
            <li class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-[#ff7a59]"></span>
              <span><%= [ingredient.quantity, ingredient.unit, ingredient.name].compact_blank.join(" ") %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No ingredients yet.</p>
      <% end %>
    </div>

    <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-sm shadow-orange-100/60 dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none">
      <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Instructions</h2>
      <% if recipe.instructions.any? %>
        <ol class="mt-4 space-y-3 text-sm text-slate-700 dark:text-slate-200">
          <% recipe.instructions.each_with_index do |instruction, index| %>
            <li class="flex gap-3">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#ffe6d6] text-xs font-semibold text-[#b14a30] dark:bg-slate-800 dark:text-slate-200">
                <%= index + 1 %>
              </span>
              <span class="flex-1"><%= instruction.body %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No instructions yet.</p>
      <% end %>
    </div>
  </section>
</div>
