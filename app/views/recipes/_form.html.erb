<%= form_with(model: recipe, class: "space-y-8") do |form| %>
  <% input_base = "w-full rounded-none border-2 bg-white px-4 py-3 text-sm text-neutral-900 focus:outline-none focus:ring-2 focus:ring-black/10" %>
  <% ok_border = "border-neutral-300 focus:border-black" %>
  <% error_border = "border-black focus:border-black" %>

  <% units = %w[clove cup g kg l lb ml oz piece pinch tbsp tsp] %>

  <% if recipe.errors.any? %>
    <div id="error_explanation" class="rounded-none border-2 border-black bg-neutral-50 px-4 py-3 text-sm font-semibold text-neutral-900">
      <h2><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-neutral-700">
        <% recipe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-none border-2 border-neutral-200 bg-white p-4 md:p-8">
    <h2 class="text-2xl font-semibold text-black">The essentials</h2>
    <p class="mt-2 text-sm text-neutral-500">Name it, describe it, and add a photo if you have one.</p>

    <div class="mt-6 space-y-4">
      <div>
        <%= form.label :name, class: "text-sm font-semibold text-neutral-700" %>
        <%= form.text_field :name, class: "#{input_base} mt-2 #{recipe.errors[:name].any? ? error_border : ok_border}" %>
      </div>

      <div>
        <%= form.label :description, class: "text-sm font-semibold text-neutral-700" %>
        <%= form.textarea :description, rows: 4, class: "#{input_base} mt-2 #{recipe.errors[:description].any? ? error_border : ok_border}" %>
      </div>

      <div>
        <%= form.label :image, class: "text-sm font-semibold text-neutral-700" %>
        <% if recipe.image.attached? %>
          <div class="mt-3 overflow-hidden rounded-none border-2 border-neutral-200 bg-neutral-100">
            <%= image_tag recipe.image.variant(resize_to_limit: [600, 600], format: :jpg), class: "h-40 w-full object-cover" %>
          </div>
          <div class="mt-3 flex items-center gap-2 text-sm text-neutral-600">
            <%= form.check_box :remove_image, class: "h-4 w-4 rounded-none border-2 border-neutral-300 text-black focus:ring-black/10" %>
            <%= form.label :remove_image, "Remove image", class: "font-semibold" %>
          </div>
        <% end %>
        <%= form.file_field :image, accept: "image/*", class: "#{input_base} mt-2 #{recipe.errors[:image].any? ? error_border : ok_border}" %>
      </div>
    </div>
  </div>

  <div class="rounded-none border-2 border-neutral-200 bg-white p-4 md:p-8" data-controller="nested-fields">
    <h2 class="text-2xl font-semibold text-black">Ingredients</h2>
    <p class="mt-2 text-sm text-neutral-500">Keep quantities in order so they are easy to scan.</p>

    <div class="mt-5 space-y-4" data-nested-fields-target="ingredients">
      <%= form.fields_for :ingredients do |ingredient_fields| %>
        <div class="flex items-end gap-4">
          <div class="min-w-0 flex-1">
            <%= ingredient_fields.label :name, class: "text-sm font-semibold text-neutral-700" %>
            <%= ingredient_fields.text_field :name, class: "#{input_base} mt-2 #{ingredient_fields.object.errors[:name].any? ? error_border : ok_border}" %>
          </div>
          <div class="shrink-0">
            <%= ingredient_fields.label :quantity, "Amount", class: "text-sm font-semibold text-neutral-700" %>
            <%= ingredient_fields.label :unit, class: "sr-only" %>
            <div class="mt-2 flex items-stretch">
              <%= ingredient_fields.text_field :quantity, placeholder: "Qty", class: "#{input_base} #{ingredient_fields.object.errors[:quantity].any? ? error_border : ok_border} w-16 rounded-r-none" %>
              <%= ingredient_fields.select :unit, options_for_select(units, ingredient_fields.object.unit), { include_blank: "Unit" }, class: "#{input_base} #{ingredient_fields.object.errors[:unit].any? ? error_border : ok_border} w-24 rounded-l-none -ml-px" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <button type="button" class="mt-4 inline-flex items-center rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black cursor-pointer" data-action="nested-fields#addIngredient">Add ingredient</button>

    <template data-nested-fields-target="ingredientTemplate">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_fields| %>
        <div class="flex items-end gap-4">
          <div class="min-w-0 flex-1">
            <%= ingredient_fields.label :name, class: "text-sm font-semibold text-neutral-700" %>
            <%= ingredient_fields.text_field :name, class: "#{input_base} mt-2 #{ok_border}" %>
          </div>
          <div class="shrink-0">
            <%= ingredient_fields.label :quantity, "Amount", class: "text-sm font-semibold text-neutral-700" %>
            <%= ingredient_fields.label :unit, class: "sr-only" %>
            <div class="mt-2 flex items-stretch">
              <%= ingredient_fields.text_field :quantity, placeholder: "Qty", class: "#{input_base} #{ok_border} w-16 rounded-r-none" %>
              <%= ingredient_fields.select :unit, options_for_select(units), { include_blank: "Unit" }, class: "#{input_base} #{ok_border} w-24 rounded-l-none -ml-px" %>
            </div>
          </div>
        </div>
      <% end %>
    </template>

    <h2 class="mt-8 text-2xl font-semibold text-black">Instructions</h2>
    <p class="mt-2 text-sm text-neutral-500">Short steps keep the rhythm moving.</p>
    <ol class="mt-5 space-y-4" data-nested-fields-target="instructions">
      <%= form.fields_for :instructions do |instruction_fields| %>
        <li data-instruction-item class="rounded-none border-2 border-neutral-200 bg-neutral-50 p-4">
          <div class="flex items-start gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-none bg-black text-xs font-semibold text-white" data-step-label>1</span>
            <div class="flex-1">
              <%= instruction_fields.hidden_field :position %>
              <%= instruction_fields.text_area :body, rows: 2, class: "#{input_base} #{instruction_fields.object.errors[:body].any? ? error_border : ok_border}" %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
    <button type="button" class="mt-4 inline-flex items-center rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black cursor-pointer" data-action="nested-fields#addInstruction">Add instruction</button>

    <template data-nested-fields-target="instructionTemplate">
      <%= form.fields_for :instructions, Instruction.new, child_index: "NEW_RECORD" do |instruction_fields| %>
        <li data-instruction-item class="rounded-none border-2 border-neutral-200 bg-neutral-50 p-4">
          <div class="flex items-start gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-none bg-black text-xs font-semibold text-white" data-step-label>1</span>
            <div class="flex-1">
              <%= instruction_fields.hidden_field :position %>
              <%= instruction_fields.text_area :body, rows: 2, class: "#{input_base} #{ok_border}" %>
            </div>
          </div>
        </li>
      <% end %>
    </template>
  </div>

  <div>
    <%= form.submit class: "inline-flex rounded-none bg-black px-4 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
  </div>
<% end %>
