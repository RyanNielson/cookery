<%= form_with(model: recipe, class: "space-y-8") do |form| %>
  <% input_base = "w-full rounded-2xl border bg-white/80 px-4 py-3 text-sm text-slate-900 shadow-sm focus:outline-none focus:ring-2 dark:bg-slate-900/70 dark:text-slate-100" %>
  <% ok_border = "border-slate-200/80 focus:border-[#ff7a59] focus:ring-[#ffb49b]/60 dark:border-slate-700/80 dark:focus:ring-[#ff7a59]/40" %>
  <% error_border = "border-rose-400 focus:border-rose-500 focus:ring-rose-200 dark:border-rose-400/80 dark:focus:ring-rose-400/40" %>

  <% if recipe.errors.any? %>
    <div id="error_explanation" class="rounded-2xl border border-rose-200 bg-rose-50/90 px-4 py-3 text-sm font-semibold text-rose-700">
      <h2><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-rose-600">
        <% recipe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-sm shadow-orange-100/60 dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none md:p-8">
    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">The essentials</h2>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Name it, describe it, and add a photo if you have one.</p>

    <div class="mt-6 space-y-5">
      <div>
        <%= form.label :name, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
        <%= form.text_field :name, class: "#{input_base} mt-2 #{recipe.errors[:name].any? ? error_border : ok_border}" %>
      </div>

      <div>
        <%= form.label :description, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
        <%= form.textarea :description, rows: 4, class: "#{input_base} mt-2 #{recipe.errors[:description].any? ? error_border : ok_border}" %>
      </div>

      <div>
        <%= form.label :image, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
        <% if recipe.image.attached? %>
          <div class="mt-3 overflow-hidden rounded-2xl border border-slate-200/60 bg-slate-100 dark:border-slate-800/60 dark:bg-slate-900">
            <%= image_tag recipe.image.variant(resize_to_limit: [600, 600], format: :jpg), class: "h-48 w-full object-cover" %>
          </div>
          <div class="mt-3 flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
            <%= form.check_box :remove_image, class: "h-4 w-4 rounded border-slate-300 text-[#ff7a59] focus:ring-[#ffb49b]/60" %>
            <%= form.label :remove_image, "Remove image", class: "font-semibold" %>
          </div>
        <% end %>
        <%= form.file_field :image, accept: "image/*", class: "#{input_base} mt-2 #{recipe.errors[:image].any? ? error_border : ok_border}" %>
      </div>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200/70 bg-white/80 p-6 shadow-sm shadow-orange-100/60 dark:border-slate-800/70 dark:bg-slate-950/60 dark:shadow-none md:p-8" data-controller="nested-fields">
    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Ingredients</h2>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Keep quantities in order so they are easy to scan.</p>

    <div class="mt-5 space-y-4" data-nested-fields-target="ingredients">
      <%= form.fields_for :ingredients do |ingredient_fields| %>
        <div class="flex items-end gap-4">
          <div class="min-w-0 flex-1">
            <%= ingredient_fields.label :name, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
            <%= ingredient_fields.text_field :name, class: "#{input_base} mt-2 #{ingredient_fields.object.errors[:name].any? ? error_border : ok_border}" %>
          </div>
          <div class="shrink-0">
            <%= ingredient_fields.label :quantity, "Amount", class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
            <%= ingredient_fields.label :unit, class: "sr-only" %>
            <div class="mt-2 flex">
              <%= ingredient_fields.text_field :quantity, placeholder: "Qty", class: "#{input_base} #{ingredient_fields.object.errors[:quantity].any? ? error_border : ok_border} rounded-r-none focus:z-10 w-16" %>
              <%= ingredient_fields.text_field :unit, placeholder: "Unit", class: "#{input_base} #{ingredient_fields.object.errors[:unit].any? ? error_border : ok_border} rounded-l-none -ml-px focus:z-10 w-20" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <button type="button" class="mt-4 inline-flex items-center rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#ff7a59] hover:text-[#ff613c] cursor-pointer dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100" data-action="nested-fields#addIngredient">Add ingredient</button>

    <template data-nested-fields-target="ingredientTemplate">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_fields| %>
        <div class="flex items-end gap-4">
          <div class="min-w-0 flex-1">
            <%= ingredient_fields.label :name, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
            <%= ingredient_fields.text_field :name, class: "#{input_base} mt-2 #{ok_border}" %>
          </div>
          <div class="shrink-0">
            <%= ingredient_fields.label :quantity, "Amount", class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
            <%= ingredient_fields.label :unit, class: "sr-only" %>
            <div class="mt-2 flex">
              <%= ingredient_fields.text_field :quantity, placeholder: "Qty", class: "#{input_base} #{ok_border} rounded-r-none focus:z-10 w-16" %>
              <%= ingredient_fields.text_field :unit, placeholder: "Unit", class: "#{input_base} #{ok_border} rounded-l-none -ml-px focus:z-10 w-20" %>
            </div>
          </div>
        </div>
      <% end %>
    </template>

    <h2 class="mt-8 text-2xl font-semibold text-slate-900 dark:text-white">Instructions</h2>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Short steps keep the rhythm moving.</p>
    <ol class="mt-5 space-y-4" data-nested-fields-target="instructions">
      <%= form.fields_for :instructions do |instruction_fields| %>
        <li data-instruction-item class="rounded-2xl border border-slate-200/70 bg-white/90 p-4 dark:border-slate-700/70 dark:bg-slate-900/70">
          <div class="flex items-start gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#ffe6d6] text-xs font-semibold text-[#b14a30]" data-step-label>1</span>
            <div class="flex-1">
              <%= instruction_fields.hidden_field :position %>
              <%= instruction_fields.text_area :body, rows: 2, class: "#{input_base} #{instruction_fields.object.errors[:body].any? ? error_border : ok_border}" %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
    <button type="button" class="mt-4 inline-flex items-center rounded-full border border-slate-200/80 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#ff7a59] hover:text-[#ff613c] cursor-pointer dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100" data-action="nested-fields#addInstruction">Add instruction</button>

    <template data-nested-fields-target="instructionTemplate">
      <%= form.fields_for :instructions, Instruction.new, child_index: "NEW_RECORD" do |instruction_fields| %>
        <li data-instruction-item class="rounded-2xl border border-slate-200/70 bg-white/90 p-4 dark:border-slate-700/70 dark:bg-slate-900/70">
          <div class="flex items-start gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#ffe6d6] text-xs font-semibold text-[#b14a30]" data-step-label>1</span>
            <div class="flex-1">
              <%= instruction_fields.hidden_field :position %>
              <%= instruction_fields.text_area :body, rows: 2, class: "#{input_base} #{ok_border}" %>
            </div>
          </div>
        </li>
      <% end %>
    </template>
  </div>

  <div>
    <%= form.submit class: "inline-flex rounded-full bg-[#ff7a59] px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-[#ff613c] dark:shadow-none" %>
  </div>
<% end %>
