<% content_for :title, "Showing recipe" %>

<div class="w-full space-y-8">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <%= render @recipe %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Edit recipe", edit_recipe_path(@recipe), class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
    <%= button_to "Delete recipe", @recipe, method: :delete, class: "rounded-none bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-neutral-800 cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
