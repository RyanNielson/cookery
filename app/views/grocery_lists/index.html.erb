<% content_for :title, "Grocery lists" %>

<div class="w-full space-y-8">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-4xl font-semibold leading-tight text-black sm:text-5xl">Grocery lists</h1>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "New grocery list", new_grocery_list_path, class: "inline-flex items-center rounded-none bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2 animate-stagger">
    <% if @grocery_lists.any? %>
      <% @grocery_lists.each do |grocery_list| %>
        <div class="rounded-none border-2 border-neutral-200 bg-white p-4 transition hover:-translate-y-0.5">
          <h2 class="text-xl font-semibold text-black"><%= grocery_list.name %></h2>
          <div class="mt-3 flex flex-wrap gap-4 text-xs font-semibold uppercase tracking-wide text-neutral-400">
            <span><%= pluralize(grocery_list.grocery_list_items.size, "item") %></span>
            <span><%= pluralize(Array(grocery_list.selected_recipe_ids).size, "meal") %></span>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <%= link_to "View list", grocery_list_path(grocery_list), class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-xs font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
            <%= button_to "Delete", grocery_list_path(grocery_list), method: :delete, class: "rounded-none border-2 border-black bg-black px-4 py-2 text-xs font-semibold text-white transition hover:bg-neutral-800", data: { turbo_confirm: "Delete this grocery list?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-8 text-center">
        <p class="text-lg font-semibold text-neutral-900">No grocery lists yet.</p>
        <p class="mt-2 text-sm text-neutral-500">Create a list from your favorite recipes.</p>
        <%= link_to "Create your first list", new_grocery_list_path, class: "mt-6 inline-flex items-center rounded-none bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
      </div>
    <% end %>
  </div>
</div>
