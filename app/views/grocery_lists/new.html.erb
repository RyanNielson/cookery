<% content_for :title, "New grocery list" %>

<div class="w-full space-y-8">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-black bg-neutral-900 px-4 py-2 text-sm font-semibold text-white" id="alert">
      <span class="inline-flex h-2 w-2 rounded-none bg-white"></span>
      <%= alert %>
    </p>
  <% end %>

  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-4xl font-semibold leading-tight text-black sm:text-5xl">New grocery list</h1>
    </div>
  </section>

  <% if @grocery_list.errors.any? %>
    <div class="rounded-none border-2 border-black bg-neutral-50 p-5 text-sm text-neutral-900">
      <p class="font-semibold"><%= pluralize(@grocery_list.errors.count, "error") %> stopped this list from saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @grocery_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @grocery_list, url: grocery_lists_path, method: :post, class: "grid gap-4 lg:grid-cols-3" do |form| %>
    <section class="rounded-none border-2 border-neutral-200 bg-white p-4">
      <h2 class="text-xl font-semibold text-black">List details</h2>

      <div class="mt-5">
        <%= form.label :name, class: "text-sm font-semibold text-neutral-700" %>
        <%= form.text_field :name, class: "mt-2 w-full rounded-none border-2 border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 focus:border-black focus:outline-none focus:ring-2 focus:ring-black/10" %>
      </div>

      <div class="mt-6">
        <label class="text-sm font-semibold text-neutral-700">Extra items</label>
        <p class="mt-2 text-xs text-neutral-500">One item per line (e.g., paper towels).</p>
        <%= text_area_tag :extra_items, @extra_items_text, rows: 5, class: "mt-2 w-full rounded-none border-2 border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 focus:border-black focus:outline-none focus:ring-2 focus:ring-black/10" %>
      </div>
    </section>

    <section class="rounded-none border-2 border-neutral-200 bg-white p-4">
      <h2 class="text-xl font-semibold text-black">Plan picks</h2>
      <p class="mt-2 text-sm text-neutral-500">Bring in recipes from your weekly plans. Only current or upcoming weeks are listed.</p>

      <% if @meal_plans.any? %>
        <div class="mt-6 space-y-3">
          <% @meal_plans.each do |meal_plan| %>
            <label class="flex items-start gap-3 rounded-none border-2 border-neutral-200 bg-neutral-50 px-4 py-3 text-sm font-medium text-neutral-800 transition hover:border-black">
              <%= check_box_tag "meal_plan_ids[]", meal_plan.id, @selected_meal_plan_ids.include?(meal_plan.id.to_s), class: "mt-1 h-4 w-4 rounded-none border-2 border-neutral-300 text-black focus:ring-black" %>
              <span>
                <span class="block text-base font-semibold">
                  Week of <%= meal_plan.starts_on.strftime("%B %-d") %> – <%= (meal_plan.starts_on + 6.days).strftime("%B %-d") %>
                </span>
                <span class="mt-1 block text-xs font-semibold uppercase tracking-wide text-neutral-400">
                  <%= pluralize(meal_plan.meal_plan_entries.size, "meal") %>
                </span>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="mt-6 rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-500">No current or upcoming plans yet. Add a plan to pull recipes in.</p>
        <%= link_to "Plan meals", meal_plan_path, class: "mt-4 inline-flex rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-xs font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
      <% end %>
    </section>

    <section class="rounded-none border-2 border-neutral-200 bg-white p-4">
      <h2 class="text-xl font-semibold text-black">Pick meals</h2>
      <p class="mt-2 text-sm text-neutral-500">Select recipes to include their ingredients.</p>

      <% if @recipes.any? %>
        <div class="mt-6 space-y-3">
          <% @recipes.each do |recipe| %>
            <label class="flex items-start gap-3 rounded-none border-2 border-neutral-200 bg-neutral-50 px-4 py-3 text-sm font-medium text-neutral-800 transition hover:border-black">
              <%= check_box_tag "recipe_ids[]", recipe.id, @selected_recipe_ids.include?(recipe.id), class: "mt-1 h-4 w-4 rounded-none border-2 border-neutral-300 text-black focus:ring-black" %>
              <span>
                <span class="block text-base font-semibold"><%= recipe.name %></span>
                <% if recipe.description.present? %>
                  <span class="mt-1 block text-sm text-neutral-500"><%= recipe.description %></span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="mt-6 rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-500">No recipes yet. Add recipes to build a list.</p>
      <% end %>
    </section>

    <div class="lg:col-span-3 flex flex-wrap gap-3">
      <%= form.submit "Create grocery list", class: "rounded-none bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800" %>
    </div>
  <% end %>
</div>
