<% content_for :title, "New grocery list" %>

<div class="w-full space-y-10">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="inline-flex items-center gap-2 rounded-full bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700" id="alert">
      <span class="inline-flex h-2 w-2 rounded-full bg-rose-500"></span>
      <%= alert %>
    </p>
  <% end %>

  <section class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-4xl font-semibold leading-tight text-slate-900 dark:text-white sm:text-5xl">New grocery list</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Pick meals, add extra items, and generate a list you can check off.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Back to lists", grocery_lists_path, class: "rounded-full border border-slate-200/80 bg-white/80 px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-[#ff7a59] hover:text-[#ff613c] dark:border-slate-700/80 dark:bg-slate-900/80 dark:text-slate-100" %>
    </div>
  </section>

  <% if @grocery_list.errors.any? %>
    <div class="rounded-3xl border border-rose-200/80 bg-rose-50/80 p-5 text-sm text-rose-700">
      <p class="font-semibold"><%= pluralize(@grocery_list.errors.count, "error") %> stopped this list from saving:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @grocery_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @grocery_list, url: grocery_lists_path, method: :post, class: "grid gap-6 lg:grid-cols-2" do |form| %>
    <section class="rounded-3xl border border-slate-200/80 bg-white/80 p-6 shadow-sm dark:border-slate-700/80 dark:bg-slate-900/80">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">List details</h2>

      <div class="mt-5">
        <%= form.label :name, class: "text-sm font-semibold text-slate-700 dark:text-slate-200" %>
        <%= form.text_field :name, class: "mt-2 w-full rounded-2xl border border-slate-200/80 bg-white px-4 py-2.5 text-sm text-slate-800 shadow-sm focus:border-[#ff7a59] focus:outline-none dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-100" %>
      </div>

      <div class="mt-6">
        <label class="text-sm font-semibold text-slate-700 dark:text-slate-200">Extra items</label>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">One item per line (e.g., paper towels).</p>
        <%= text_area_tag :extra_items, @extra_items_text, rows: 5, class: "mt-2 w-full rounded-2xl border border-slate-200/80 bg-white px-4 py-2.5 text-sm text-slate-800 shadow-sm focus:border-[#ff7a59] focus:outline-none dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-100" %>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200/80 bg-white/80 p-6 shadow-sm dark:border-slate-700/80 dark:bg-slate-900/80">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Pick meals</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Select recipes to include their ingredients.</p>

      <% if @recipes.any? %>
        <div class="mt-6 space-y-3">
          <% @recipes.each do |recipe| %>
            <label class="flex items-start gap-3 rounded-2xl border border-slate-200/80 bg-white/70 px-4 py-3 text-sm font-medium text-slate-800 transition hover:border-[#ff7a59] dark:border-slate-700/80 dark:bg-slate-950/40 dark:text-slate-100">
              <%= check_box_tag "recipe_ids[]", recipe.id, @selected_recipe_ids.include?(recipe.id), class: "mt-1 h-4 w-4 rounded border-slate-300 text-[#ff7a59] focus:ring-[#ff7a59]" %>
              <span>
                <span class="block text-base font-semibold"><%= recipe.name %></span>
                <% if recipe.description.present? %>
                  <span class="mt-1 block text-sm text-slate-500 dark:text-slate-400"><%= recipe.description %></span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white/70 p-4 text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/40 dark:text-slate-400">No recipes yet. Add recipes to build a list.</p>
      <% end %>
    </section>

    <div class="lg:col-span-2 flex flex-wrap gap-3">
      <%= form.submit "Create grocery list", class: "rounded-full bg-[#ff7a59] px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-[#ff613c] dark:shadow-none" %>
    </div>
  <% end %>
</div>
