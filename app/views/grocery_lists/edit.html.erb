<% content_for :title, "Editing grocery list" %>

<div class="w-full space-y-6">
  <h1 class="text-3xl font-semibold text-black">Editing grocery list</h1>

  <%= render "form", grocery_list: @grocery_list %>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Show this grocery list", @grocery_list, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
    <%= link_to "Back to grocery lists", grocery_lists_path, class: "rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:border-black hover:text-black" %>
  </div>
</div>
