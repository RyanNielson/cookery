<% content_for :title, @grocery_list.name %>
<%= turbo_stream_from @grocery_list %>

<div class="w-full space-y-8">
  <% if notice.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700" id="notice">
      <span class="inline-flex h-2 w-2 rounded-none bg-black"></span>
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="inline-flex items-center gap-2 rounded-none border-2 border-black bg-neutral-900 px-4 py-2 text-sm font-semibold text-white" id="alert">
      <span class="inline-flex h-2 w-2 rounded-none bg-white"></span>
      <%= alert %>
    </p>
  <% end %>

  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-4xl font-semibold leading-tight text-black sm:text-5xl"><%= @grocery_list.name %></h1>
      <p class="mt-2 text-sm text-neutral-500">Check items off as you shop.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= button_to "Delete list", @grocery_list, method: :delete, class: "rounded-none border-2 border-black bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800", data: { turbo_confirm: "Delete this grocery list?" } %>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="order-2 rounded-none border-2 border-neutral-200 bg-white p-4 lg:order-2">
      <h2 class="text-xl font-semibold text-black">Selected meals</h2>
      <p class="mt-2 text-sm text-neutral-500">Recipes this list pulls from.</p>

      <% if @selected_recipes_with_counts.any? %>
        <div class="mt-6 space-y-3 animate-stagger">
          <% @selected_recipes_with_counts.each do |recipe, count| %>
            <%= link_to recipe_path(recipe), class: "block rounded-none border-2 border-neutral-200 bg-neutral-50 px-4 py-3 text-sm font-semibold text-neutral-800 transition hover:border-black hover:text-black" do %>
              <span><%= recipe.name %></span>
              <% if count > 1 %>
                <span class="ml-2 rounded-none bg-white px-2 py-0.5 text-xs font-semibold text-neutral-500">x<%= count %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-6 rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-500">No recipes linked to this list.</p>
      <% end %>
    </section>

    <section class="order-1 rounded-none border-2 border-neutral-200 bg-white p-4 lg:order-1">
      <h2 class="text-xl font-semibold text-black">Grocery items</h2>
      <p class="mt-2 text-sm text-neutral-500">Ingredients plus any extra items you added.</p>

      <%= form_with model: [@grocery_list, GroceryListItem.new], class: "mt-6 grid gap-3 sm:grid-cols-3" do |form| %>
        <div class="sm:col-span-2">
          <%= form.label :name, "Add item", class: "text-xs font-semibold uppercase tracking-wide text-neutral-400" %>
          <%= form.text_field :name, class: "mt-2 w-full rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm text-neutral-800 focus:border-black focus:outline-none focus:ring-2 focus:ring-black/10" %>
        </div>
        <div>
          <%= form.label :quantity_text, "Quantity", class: "text-xs font-semibold uppercase tracking-wide text-neutral-400" %>
          <%= form.text_field :quantity_text, class: "mt-2 w-full rounded-none border-2 border-neutral-300 bg-white px-4 py-2 text-sm text-neutral-800 focus:border-black focus:outline-none focus:ring-2 focus:ring-black/10" %>
        </div>
        <div class="sm:col-span-3">
          <%= form.submit "Add to list", class: "rounded-none bg-black px-4 py-2 text-xs font-semibold text-white transition hover:bg-neutral-800" %>
        </div>
      <% end %>

      <% if @grocery_list_items.any? %>
        <div class="mt-6 space-y-3 animate-stagger">
          <% @grocery_list_items.each do |item| %>
            <%= render partial: "grocery_list_items/grocery_list_item", locals: { grocery_list: @grocery_list, item: item } %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-6 rounded-none border-2 border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-500">No items yet.</p>
      <% end %>
    </section>
  </div>
</div>
