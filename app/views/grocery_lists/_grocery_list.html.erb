<div id="<%= dom_id grocery_list %>" class="w-full sm:w-auto my-5 space-y-4">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= grocery_list.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Selected recipe ids:</strong>
    <%= grocery_list.selected_recipe_ids %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= grocery_list.user_id %>
  </div>
</div>
