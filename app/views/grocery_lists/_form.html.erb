<%= form_with(model: grocery_list, class: "contents") do |form| %>
  <% if grocery_list.errors.any? %>
    <div id="error_explanation" class="mt-3 rounded-none border-2 border-black bg-neutral-50 px-3 py-2 font-medium text-neutral-900">
      <h2><%= pluralize(grocery_list.errors.count, "error") %> prohibited this grocery_list from being saved:</h2>

      <ul class="ml-6 list-disc text-neutral-700">
        <% grocery_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list.errors[:name].none?, "border-black": grocery_list.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :selected_recipe_ids %>
    <%= form.textarea :selected_recipe_ids, rows: 4, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list.errors[:selected_recipe_ids].none?, "border-black": grocery_list.errors[:selected_recipe_ids].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["mt-2 block w-full rounded-none border-2 px-3 py-2 focus:border-black focus:ring-2 focus:ring-black/10", {"border-neutral-300": grocery_list.errors[:user_id].none?, "border-black": grocery_list.errors[:user_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "inline-block w-full rounded-none bg-black px-3.5 py-2.5 font-medium text-white hover:bg-neutral-800 sm:w-auto cursor-pointer" %>
  </div>
<% end %>
